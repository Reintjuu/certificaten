{
  "name": "queeste-certificaten",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github-pages": "vite build --base=/certificaten/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate-levels": "tsx src/agent/validate.ts",
    "train-agent": "tsx src/agent/train.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  }
}
